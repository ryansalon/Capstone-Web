DATABASE_URL=sqlite:///platform.db
# Production example (Render Postgres / Neon / Supabase):
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
FLASK_ENV=development
# Set FLASK_ENV=production and a 32+ char random JWT_SECRET + unique API_KEY in production.
JWT_SECRET=change-me-jwt-secret-min-32-chars-long
JWT_EXPIRATION_HOURS=24
API_KEY=dev-kiosk-key
# Comma-separated allowed CORS origins in production (leave blank for same-origin only).
# CORS_ORIGINS=https://your-domain.example
PORT=5000
